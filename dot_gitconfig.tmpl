{{- $machine := includeTemplate "machine.json.tmpl" . | mustFromJson -}}
{{- $identity := get $machine "git" | default dict -}}
{{- $name := get $identity "name" | default (index . "gitName") -}}
{{- $email := get $identity "email" | default (index . "gitEmail") -}}
{{- if or (not $name) (not $email) -}}
{{- fail "git identity unset: supply machine.json git.name/email or chezmoi data gitName/gitEmail" -}}
{{- end -}}
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[user]
	name = {{ $name | quote }}
	email = {{ $email | quote }}
{{ range (get $identity "workDirectories" | default list) }}
[includeIf {{ printf "gitdir:%s/" (trimSuffix "/" .) | quote }}]
	path = {{ joinPath $.chezmoi.destDir ".config/git/identity-work" | quote }}
{{ end }}
{{ range (get $identity "workRemotePatterns" | default list) }}
[includeIf {{ printf "hasconfig:remote.*.url:%s" . | quote }}]
	path = {{ joinPath $.chezmoi.destDir ".config/git/identity-work" | quote }}
{{ end }}
{{ range (get $identity "personalRemotePatterns" | default list) }}
[includeIf {{ printf "hasconfig:remote.*.url:%s" . | quote }}]
	path = {{ joinPath $.chezmoi.destDir ".config/git/identity-personal" | quote }}
{{ end }}
[credential "https://github.com"]
	helper = 
	helper = !{{ lookPath "gh" | default "gh" }} auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !{{ lookPath "gh" | default "gh" }} auth git-credential
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
