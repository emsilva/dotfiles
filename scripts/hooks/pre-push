#!/bin/sh
# Refuse a push whose outgoing commits hit the private deny-list or gitleaks.
# Enable per clone with `task hooks:install` (core.hooksPath = scripts/hooks).
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref.
scan="${0%/*}/../scan.py"
status=0
while read -r _ local_sha remote_ref remote_sha; do
    case $local_sha in *[!0]*) ;; *) continue ;; esac  # a delete pushes no content
    case $remote_sha in
        *[!0]*) if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
                    set -- "$remote_sha..$local_sha"
                else
                    set -- "$local_sha" --not --remotes  # remote tip unknown here
                fi ;;
        *) set -- "$local_sha" --not --remotes ;;  # new remote branch
    esac
    echo "pre-push: scanning $remote_ref ($*)" >&2
    python3 -I "$scan" range -- "$@" || status=1
done
[ "$status" -eq 0 ] || echo 'pre-push: scan failed; push refused' >&2
exit "$status"
