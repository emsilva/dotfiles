{{- $machine := includeTemplate "machine.json.tmpl" . | mustFromJson -}}
{{- $settings := include ".chezmoitemplates/claude-settings.json" | mustFromJson -}}
{{- $settings = mustMergeOverwrite $settings (get $machine "claudeSettings" | default dict) -}}
{{- /* Preserve the current runtime model, reading the selected destination only. */ -}}
{{- $live := joinPath .chezmoi.destDir ".claude/settings.json" -}}
{{- if stat $live -}}
{{- $current := include $live | mustFromJson -}}
{{- if hasKey $current "model" -}}
{{- $_ := set $settings "model" (get $current "model") -}}
{{- end -}}
{{- end -}}
{{ $settings | mustToPrettyJson }}
